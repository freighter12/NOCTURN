{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOCTURN",
  "version": "0.2.0",
  "identifier": "app.nocturn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOCTURN",
        "width": 1380,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://media.localhost; media-src http://media.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://media.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Windows optimisation engine and AI desktop assistant",
    "longDescription": "NOCTURN inspects, explains and optimises Windows with reversible, journaled changes, and includes an AI technician that understands your PC.",
    "copyright": "© 2026 NOCTURN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2Nzg3MkNENTFCMDY3QzcKUldUSFo3QlJ6WEo0ZGlhRkpmbmpqbTJRYkZlQ1l1c0lkTTlobnNOR3cvNzRDTmo5ZnlJRm41R0sK",
      "endpoints": [
        "https://github.com/freighter12/NOCTURN/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
